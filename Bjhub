-- Helper: semi-transparent text box (same look for both boxes)
local function makeBox(y, placeholder)
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, -20, 0, 34)
    box.Position = UDim2.fromOffset(10, y)
    box.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    box.BackgroundTransparency = 0.45
    box.BorderSizePixel = 0
    box.Text = ""
    box.PlaceholderText = placeholder
    box.PlaceholderColor3 = Color3.fromRGB(190, 190, 190)
    box.TextColor3 = Color3.new(1, 1, 1)
    box.Font = Enum.Font.Gotham
    box.TextSize = 14
    box.ClearTextOnFocus = false
    box.Parent = frame
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 8)
    local stroke = Instance.new("UIStroke", box)
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Transparency = 0.5
    return box
end

-- Helper: solid button (same look for all main buttons)
local function makeButton(y, text, color)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -20, 0, 36)
    b.Position = UDim2.fromOffset(10, y)
    b.BackgroundColor3 = color
    b.BackgroundTransparency = 0
    b.BorderSizePixel = 0
    b.Text = text
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 16
    b.Parent = frame
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    return b
end

local function flash(btn, text, color, defaultText, defaultColor)
    btn.Text = text
    btn.BackgroundColor3 = color
    task.delay(1.2, function()
        if btn and btn.Parent then
            btn.Text = defaultText
            btn.BackgroundColor3 = defaultColor
        end
    end)
end

local function getRoot()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

-- Coordinate teleport
local coordBox = makeBox(38, "Enter position: X, Y, Z")
local tpButton = makeButton(82, "TELEPORT!", BLUE)

tpButton.MouseButton1Click:Connect(function()
    local nums = {}
    for n in string.gmatch(coordBox.Text, "-?%d*%.?%d+") do
        table.insert(nums, tonumber(n))
    end

    if #nums < 3 then
        flash(tpButton, "Enter X, Y, Z", RED, "TELEPORT!", BLUE)
        return
    end

    local hrp = getRoot()
    if not hrp then
        flash(tpButton, "No character", RED, "TELEPORT!", BLUE)
        return
    end

    hrp.CFrame = CFrame.new(nums[1], nums[2], nums[3])
    flash(tpButton, "Teleported!", GREEN, "TELEPORT!", BLUE)
end)

-- Checkpoints
local nameBox = makeBox(126, "Checkpoint name (optional)")
nameBox.Size = UDim2.new(1, -20, 0, 30)
local cpButton = makeButton(162, "MAKE CHECKPOINT", GREEN)

local ROW_H = 34
local MAX_VISIBLE = 4

local scroll = Instance.new("ScrollingFrame")
scroll.Position = UDim2.fromOffset(10, 206)
scroll.Size = UDim2.new(1, -20, 0, 0)
scroll.BackgroundTransparency = 1
scroll.BorderSizePixel = 0
scroll.ScrollBarThickness = 3
scroll.CanvasSize = UDim2.new()
scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
scroll.Visible = false
scroll.Parent = frame

local layout = Instance.new("UIListLayout", scroll)
layout.Padding = UDim.new(0, 4)
layout.SortOrder = Enum.SortOrder.LayoutOrder

local cpCount = 0   -- checkpoints currently shown
local cpMade = 0    -- total made (used for default names)

local function updateSize()
    local visible = math.min(cpCount, MAX_VISIBLE)
    scroll.Visible = cpCount > 0
    scroll.Size = UDim2.new(1, -20, 0, visible * ROW_H)
    frame.Size = UDim2.fromOffset(250, BASE_H + (cpCount > 0 and (visible * ROW_H + 6) or 0))
end

cpButton.MouseButton1Click:Connect(function()
    local hrp = getRoot()
    if not hrp then
        flash(cpButton, "No character", RED, "MAKE CHECKPOINT", GREEN)
        return
    end

    local savedPos = hrp.Position
    cpMade += 1
    cpCount += 1

    local name = nameBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
    if name == "" then name = "Checkpoint " .. cpMade end
    nameBox.Text = ""

    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -6, 0, 30)
    row.BackgroundTransparency = 1
    row.LayoutOrder = cpMade
    row.Parent = scroll

    local goBtn = Instance.new("TextButton")
    goBtn.Size = UDim2.new(1, -34, 1, 0)
    goBtn.BackgroundColor3 = BLUE
    goBtn.BackgroundTransparency = 0
    goBtn.BorderSizePixel = 0
    goBtn.Text = name
    goBtn.TextColor3 = Color3.new(1, 1, 1)
    goBtn.Font = Enum.Font.GothamBold
    goBtn.TextSize = 14
    goBtn.TextTruncate = Enum.TextTruncate.AtEnd
    goBtn.Parent = row
    Instance.new("UICorner", goBtn).CornerRadius = UDim.new(0, 8)

    local delBtn = Instance.new("TextButton")
    delBtn.Size = UDim2.new(0, 28, 1, 0)
    delBtn.Position = UDim2.new(1, -28, 0, 0)
    delBtn.BackgroundColor3 = RED
    delBtn.BackgroundTransparency = 0.3
    delBtn.BorderSizePixel = 0
    delBtn.Text = "X"
    delBtn.TextColor3 = Color3.new(1, 1, 1)
    delBtn.Font = Enum.Font.GothamBold
    delBtn.TextSize = 14
    delBtn.Parent = row
    Instance.new("UICorner", delBtn).CornerRadius = UDim.new(0, 6)

    goBtn.MouseButton1Click:Connect(function()
        local root = getRoot()
        if root then
            root.CFrame = CFrame.new(savedPos)
        end
    end)

    delBtn.MouseButton1Click:Connect(function()
        row:Destroy()
        cpCount -= 1
        updateSize()
    end)

    updateSize()
    flash(cpButton, "Saved!", BLUE, "MAKE CHECKPOINT", GREEN)
end)

