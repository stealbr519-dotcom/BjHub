--[[
    Bjhub - Universal Teleport + Checkpoints (Keyless)
    Teleport: type  X, Y, Z  then press TELEPORT!
    Checkpoint: (optional) type a name, press MAKE CHECKPOINT.
    A new button appears that teleports you back to that spot.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

local BLUE = Color3.fromRGB(0, 140, 255)
local GREEN = Color3.fromRGB(40, 180, 80)
local RED = Color3.fromRGB(200, 50, 50)

-- Pick the safest place to put the GUI
local function getGuiParent()
    local ok, parent = pcall(function()
        if gethui then return gethui() end
        return game:GetService("CoreGui")
    end)
    if ok and parent then return parent end
    return LocalPlayer:WaitForChild("PlayerGui")
end

-- Remove old copy if executed twice
local parent = getGuiParent()
local old = parent:FindFirstChild("Ajhub")
if old then old:Destroy() end

