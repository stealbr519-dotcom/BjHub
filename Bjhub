    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    return b
end

local PURPLE = Color3.fromRGB(130, 80, 220)
local lockBtn = makeCornerButton(66, "LOCK", BLUE)
local hideBtn = makeCornerButton(110, "HIDE UI", PURPLE)

lockBtn.MouseButton1Click:Connect(function()
    locked = not locked
    if locked then
        lockBtn.Text = "UNLOCK"
        lockBtn.BackgroundColor3 = GREEN
    else
        lockBtn.Text = "LOCK"
        lockBtn.BackgroundColor3 = BLUE
    end
end)

hideBtn.MouseButton1Click:Connect(function()
    hidden = not hidden
    frame.Visible = not hidden
    topBar.Visible = not hidden
    hideBtn.Text = hidden and "SHOW UI" or "HIDE UI"
end)

-- Dragging (drag by empty frame space)
local dragging, dragStart, startPos
frame.InputBegan:Connect(function(input)
    if locked then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)
